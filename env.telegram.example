# Servicio Telegram operativo
APP_SERVICE=telegram

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGODB_DB_NAME=neotrade
TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_DE_TELEGRAM
ADMIN_TELEGRAM_IDS=123456789
MINI_APP_URL=https://tu-miniapp.com

ENABLE_API_SERVER=false
ENABLE_TELEGRAM_BOT=true
ENABLE_TRADING_ENGINE=true
ENABLE_SCHEDULER=true

LOG_LEVEL=INFO

# Recomendado mantener estos defaults si no tienes tuning final
QUOTE_ASSET=USDT
CAPITAL_ACTIVO_PORC=0.995
MIN_USDT_ORDER=3.0
SCAN_INTERVAL_SECONDS=30
MAX_SYMBOLS_TO_SCAN=40
PARALLEL_SCAN_WORKERS=4
TP1_PARTIAL_MIN_QUOTE=20.0
TP1_PARTIAL_FRACTION=0.30

# Filtro de régimen global (solo permite nuevas entradas en continuación)
ENABLE_MARKET_REGIME_FILTER=true
REGIME_BTC_SYMBOL=BTC_USDT
REGIME_BREADTH_SAMPLE_SIZE=12
REGIME_BREADTH_CONTINUATION_MIN=0.45
REGIME_BREADTH_WARNING_MIN=0.25
REGIME_BREADTH_RISK_OFF_MAX=0.15
REGIME_CONFIRM_CONTINUATION_CYCLES=2
REGIME_CONFIRM_EXIT_CYCLES=2
REGIME_COOLDOWN_CYCLES_AFTER_EXIT=2
REGIME_STALE_DECISION_MAX_SECONDS=900

# Scheduler / fees
HORARIO_COBRO_FEE=12:00
HORARIO_PAGO_REFERIDOS=14:00
FEE_ADMIN_PORC=0.15
FEE_REFERIDO_PORC=0.03
FEE_SETTLEMENT_THRESHOLD=5.0
PAYMENT_ASSET=USDT
PAYMENT_METHOD=coinw_internal

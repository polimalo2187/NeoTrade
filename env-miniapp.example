# Servicio Mini App / Web API
APP_SERVICE=miniapp

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/
MONGODB_DB_NAME=neotrade
TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_DE_TELEGRAM
MINI_APP_SESSION_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_UNICO
ADMIN_TELEGRAM_IDS=123456789

ENABLE_API_SERVER=true
ENABLE_TELEGRAM_BOT=false
ENABLE_TRADING_ENGINE=false
ENABLE_SCHEDULER=false

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

MINI_APP_URL=https://tu-miniapp.com
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
MINI_APP_SESSION_TTL_SECONDS=43200
